# SLMS Backend Environment Configuration
# Copy this file to .env and adjust values as needed.

# Database connection URL (defaults to local SQLite database with WAL mode enabled)
DATABASE_URL=sqlite:///slms.db

# Cryptographic secret for signing JWT access and refresh tokens
JWT_SECRET_KEY=slms-secure-lab-secret-key-2026

# Token expiration lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8
AGENT_TOKEN_EXPIRE_MINUTES=15
