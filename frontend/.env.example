# SLMS Frontend Environment Configuration
# Copy this file to .env.local and fill in the values for your deployment.
# Never commit real credentials or secrets.

# API base URL (change for production)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# WebSocket base URL (change for production)
VITE_WS_BASE_URL=ws://127.0.0.1:8000/ws/dashboard
