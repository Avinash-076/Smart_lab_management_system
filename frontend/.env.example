# SLMS Frontend Environment Configuration
# Copy this file to .env.local (or .env) and set values for your deployment.
# Never commit real credentials, tokens, or machine-specific environment files.

# API Base URL (must use http:// or https://)
# Local development default:
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Example for LAN deployment (e.g. lab host IP):
# VITE_API_BASE_URL=http://192.168.1.100:8000/api

# WebSocket Base URL for real-time dashboard events (must use ws:// or wss://)
# If omitted or left blank, it is automatically derived from VITE_API_BASE_URL
# (http -> ws, https -> wss, targeting /ws/dashboard).
# Local development default:
VITE_WS_BASE_URL=ws://127.0.0.1:8000/ws/dashboard

# Example for LAN deployment:
# VITE_WS_BASE_URL=ws://192.168.1.100:8000/ws/dashboard
